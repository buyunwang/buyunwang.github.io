---
interface Props {
  number: string;
  title: string;
  description: string;
  tags: string[];
  link: string;
  color: string;
}

const { number, title, description, tags, link, color } = Astro.props;
---

<a 
  href={link} 
  class="group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden"
>
  <div class={`absolute inset-0 bg-gradient-to-br ${color} opacity-0 group-hover:opacity-5 transition-opacity duration-300`}></div>
  
  <div class="relative z-10">
    <span class="text-5xl font-bold text-gray-200 mb-4 block">{number}</span>
    
    <h3 class="text-xl font-semibold mb-3 group-hover:text-gray-900 transition-colors">
      {title}
    </h3>
    
    <p class="text-gray-600 mb-4 line-clamp-3">
      {description}
    </p>
    
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded-md">
          {tag}
        </span>
      ))}
    </div>
  </div>
  
  <div class="absolute bottom-8 right-8 transform translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300">
    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
</a>

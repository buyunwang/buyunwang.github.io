---
---

<a href="https://www.vancouverisawesome.com/weather?locationid=53" target="_blank" rel="noopener noreferrer" id="weather-widget" class="group flex items-center text-xs text-white bg-gray-900 rounded-full pl-2 pr-1 py-2 transition-all duration-300 ease-in-out hover:pl-2 hover:pr-2 cursor-pointer no-underline">
  <div class="flex items-center gap-1">
    <span id="weather-icon">🌤️</span>
    <span id="temperature" class="min-w-[32px]">15°C</span>
  </div>
  <span id="location" class="overflow-hidden transition-all duration-300 ease-in-out w-0 group-hover:w-16 group-hover:ml-1 whitespace-nowrap">Vancouver</span>
</a>

<script>
  const CACHE_KEY = 'vancouver_weather';
  const CACHE_DURATION = 30 * 60 * 1000;
  const VANCOUVER_LAT = 49.2827;
  const VANCOUVER_LON = -123.1207;

  const weatherCodeMap = {
    clear: { max: 3, icon: '☀️' },
    cloudy: { max: 48, icon: '☁️' },
    rain: { max: 67, icon: '🌧️' },
    snow: { max: 77, icon: '❄️' },
    showers: { max: 82, icon: '🌦️' },
    default: '🌤️'
  };

  function getWeatherIcon(code) {
    for (const [_, { max, icon }] of Object.entries(weatherCodeMap)) {
      if (code <= max) return icon;
    }
    return weatherCodeMap.default;
  }

  function updateUI(temp, icon) {
    const tempEl = document.getElementById('temperature');
    const iconEl = document.getElementById('weather-icon');
    const locEl = document.getElementById('location');
    
    if (tempEl) tempEl.textContent = temp;
    if (iconEl) iconEl.textContent = icon;
    if (locEl) locEl.textContent = 'Vancouver';
  }

  function isCacheValid(cached) {
    return cached && (Date.now() - cached.timestamp < CACHE_DURATION);
  }

  async function getVancouverWeather() {
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const data = JSON.parse(cached);
        if (isCacheValid(data)) {
          updateUI(data.temperature, data.icon);
          return;
        }
      }
      
      const res = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${VANCOUVER_LAT}&longitude=${VANCOUVER_LON}&current=temperature_2m,weather_code&timezone=auto&forecast_days=1`
      );
      
      if (!res.ok) throw new Error('API failed');
      
      const data = await res.json();
      const temp = `${Math.round(data.current.temperature_2m)}°C`;
      const icon = getWeatherIcon(data.current.weather_code);
      
      localStorage.setItem(CACHE_KEY, JSON.stringify({ temperature: temp, icon, timestamp: Date.now() }));
      updateUI(temp, icon);
    } catch (error) {
      console.log('Weather widget: Unable to fetch data');
      updateUI('--°', '🌍');
    }
  }


  function loadCache() {
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const data = JSON.parse(cached);
        if (isCacheValid(data)) {
          updateUI(data.temperature, data.icon);
          return true;
        }
      }
    } catch (e) {
      console.log('Could not load cache');
    }
    return false;
  }

  const hasCached = loadCache();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => !hasCached && getVancouverWeather());
  } else if (!hasCached) {
    getVancouverWeather();
  }
  
</script>